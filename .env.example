# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TIKTOK_WEBHOOK_SECRET: Optional secret token to verify incoming webhooks
# from authorized TikTok LIVE connectors (e.g., TikFinity, EulerStream).
TIKTOK_WEBHOOK_SECRET=""

# TIKTOK_LIVE_USERNAME: Optional default TikTok @username for live stream metadata.
TIKTOK_LIVE_USERNAME="sa_12sa_12"

# SIGN_API_KEY: Euler Stream API key used by tiktok-live-connector (SignConfig.apiKey).
# Read strictly from process.env.SIGN_API_KEY at runtime.
SIGN_API_KEY=""

# TIKTOK_CLIENT_KEY & TIKTOK_CLIENT_SECRET: TikTok Developer Portal OAuth 2.0 Login Kit credentials.
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# PI_API_KEY / ELEVENLABS_API_KEY: Optional ElevenLabs API key for Rachel (21m00Tcm4TlvDq8ikWAM) eleven_multilingual_v2 voice synthesis.
PI_API_KEY=""
ELEVENLABS_API_KEY=""

